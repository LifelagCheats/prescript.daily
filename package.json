{
  "name": "prescript.daily",
  "type": "module",
  "description": "The will of the City, now on the web.",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "release": "semantic-release",
    "dev:frontend": "pnpm --filter frontend dev",
    "preview:frontend": "pnpm --filter frontend preview",
    "typedoc:md": "pnpm --filter frontend typedoc:md",
    "typedoc:html": "pnpm --filter frontend typedoc:html",
    "storybook:live": "pnpm --filter frontend storybook",
    "storybook:build": "pnpm --filter frontend build-storybook",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck"
  },
  "lint-staged": {
    "apps/frontend/**/*.{js,ts,jsx,tsx,astro}": [
      "eslint --fix"
    ],
    "**/*.{js,ts,jsx,tsx,astro,json,css,md}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.28.6+sha512.55d90390c3b39042f1505a2697789f0256c6d95bb28bdd7cb731af1887c9f2629ef581acb9f4e4ec772024c8203c2aed22a03299b97103fdcf32668e905d0024",
  "devDependencies": {
    "@astrojs/language-server": "^2.17.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "semantic-release": "^25.0.9",
    "supabase": "^2.117.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vercel": "^58.4.4"
  },
  "dependencies": {
    "tinyexec": "1.3.0"
  },
  "version": "1.4.1"
}
