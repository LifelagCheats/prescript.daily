{
  "name": "prescript.daily",
  "type": "module",
  "description": "The will of the City, now on the web.",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "release": "semantic-release",
    "dev:frontend": "pnpm --filter frontend dev",
    "preview:frontend": "pnpm --filter frontend preview",
    "typedoc:md": "pnpm --filter frontend typedoc:md",
    "typedoc:html": "pnpm --filter frontend typedoc:html",
    "storybook:live": "pnpm --filter frontend storybook",
    "storybook:build": "pnpm --filter frontend build-storybook",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck"
  },
  "lint-staged": {
    "apps/frontend/**/*.{js,ts,jsx,tsx,astro}": [
      "eslint --fix"
    ],
    "**/*.{js,ts,jsx,tsx,astro,json,css,md}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "devDependencies": {
    "@astrojs/language-server": "^2.16.14",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.8",
    "supabase": "^2.114.0",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.65.0",
    "vercel": "^59.0.0"
  },
  "dependencies": {
    "tinyexec": "1.3.0"
  }
}
