---
import SpeedInsights from "@vercel/speed-insights/astro"
import Analytics from '@vercel/analytics/astro'

interface Props {
  title: string;
  icon: string;
}

const { title, icon } = Astro.props;
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href=`${icon}?v=1` />
  </head>
  <body>
    <slot />

    <Analytics/>
    <SpeedInsights />
  </body>
</html>
