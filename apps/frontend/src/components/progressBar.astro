---
import ProgressBar from '@components/react/progressBar'

interface Props {
  floor: number,
  progress: number,
  ceiling: number,
  header: string,
  extra: number
}

const { floor, progress, ceiling, header, extra } = Astro.props;
---

<ProgressBar floor={floor} progress={progress} ceiling={ceiling} header={header} extra={extra} client:load />
