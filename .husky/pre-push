#!/usr/bin/env sh

git fetch origin || exit 1

UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)

if [ -z "$UPSTREAM" ]; then
  echo "No upstream configured, skipping remote sync check."
  exit 0
fi

LOCAL=$(git rev-parse @)
REMOTE=$(git rev-parse @{u})

if [ "$LOCAL" = "$REMOTE" ]; then
  exit 0
fi

BASE=$(git merge-base @ @{u})

if [ "$LOCAL" = "$BASE" ]; then
  echo "❌ Your branch is behind the remote. Run 'git pull --rebase' first."
  exit 1
fi
